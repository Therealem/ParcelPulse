# Public URL used by the Next.js browser client to reach FastAPI.
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL settings. Copy these entries into backend/.env.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=parcelpulse
DATABASE_USER=parcelpulse_app
DATABASE_PASSWORD=replace_with_your_postgresql_password

# FastAPI authentication settings. Generate a long random secret for local use.
AUTH_SECRET_KEY=generate_a_unique_random_secret_do_not_commit
AUTH_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_NAME=parcelpulse_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:3000

# Backend tracking provider. Keep API tokens only in backend/.env.
SHIPPO_API_TOKEN=replace_with_shippo_api_token
EASYPOST_API_KEY=replace_with_easypost_api_key
TRACKING_PROVIDER=mock
