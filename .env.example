# Public URL used by the Next.js browser client to reach FastAPI.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# PostgreSQL settings. Copy these entries into backend/.env.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=parcelpulse
DATABASE_USER=parcelpulse_app
DATABASE_PASSWORD=replace_with_your_postgresql_password
